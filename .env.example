# 前端环境变量示例。复制为 .env 后按需修改（本地开发默认值即可直接跑通）。
# 生产环境的 PUBLIC_* 变量也可以在 Cloudflare Pages 的构建环境变量中配置。

# Worker API 基础地址（本地开发指向本地 Worker）
PUBLIC_API_BASE=http://127.0.0.1:8787

# Turnstile 站点密钥（公开键）。使用 Cloudflare 官方测试密钥则本地不弹真实人机验证；
# 留空则前端不显示人机验证组件。
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# 仅构建时使用的 Worker 认证令牌（不要加 PUBLIC_ 前缀，不会泄露给浏览器）
BUILD_API_TOKEN=change-me
