---
import { ClientRouter, fade } from 'astro:transitions';
import { Icon } from 'astro-icon/components';
import SiteToast from '../components/SiteToast.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description: rawDescription = 'FlareBlog 是一个部署在 Cloudflare 上的开源博客基座，支持文章、分类、搜索、评论与浏览量统计。',
  ogType = 'website',
  canonicalUrl,
} = Astro.props;

// 截断描述以符合 SEO 标准（通常建议在 150 字符以内）
const description = rawDescription.length > 150 ? rawDescription.substring(0, 147) + '...' : rawDescription;

const siteTitle = title === '首页' ? 'FlareBlog · 开源博客基座' : `${title} | FlareBlog`;
const finalCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site || 'https://your-domain.example').toString();
const ogImage = new URL('/favicon.png', Astro.site || 'https://your-domain.example').toString();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomeSection = currentPath === '/' || /^\/\d+$/.test(currentPath);

const navItems = [
  { href: '/', label: '首页', icon: 'lucide:house', active: isHomeSection, current: currentPath === '/' },
  { href: '/search', label: '搜索', icon: 'lucide:search', active: currentPath === '/search', current: currentPath === '/search' },
  { href: '/about', label: '关于', icon: 'lucide:info', active: currentPath === '/about', current: currentPath === '/about' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f4ed" id="theme-color-meta" />
    <!-- 防止深色模式闪烁(FOUC)的内联脚本，必须在最前 -->
    <script is:inline src="/theme-init.js"></script>
    <script is:inline src="/entry-init.js"></script>
    <script is:inline src="/title-init.js"></script>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="canonical" href={finalCanonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonicalUrl} />
    <meta property="og:site_name" content="FlareBlog" />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{siteTitle}</title>
    <!-- 站点结构化数据：让搜索引擎显示站点名称而非裸域名 -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FlareBlog",
      "alternateName": "FlareBlog",
      "url": "https://your-domain.example"
    })} />
    <ClientRouter />
  </head>
  <body transition:animate="none" class="flex flex-col bg-[var(--paper)] text-[var(--text)] selection:bg-[#d9cfb7] dark:selection:bg-[#4a4336] transition-colors duration-300">
    <div class="site-entry-loader" aria-hidden="true">
      <div class="site-entry-loader__mark">
        <span>FlareBlog</span>
        <span class="site-entry-loader__line"></span>
      </div>
    </div>
    <div class="pointer-halo" data-pointer-halo aria-hidden="true"></div>
    <header id="main-header" class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-wordmark" aria-label="FlareBlog 首页">Blog</a>

        <div class="site-header__controls">
          <nav class="site-menu" aria-label="主导航">
            {navItems.map((item) => (
              <a href={item.href} data-active={item.active ? 'true' : undefined} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>

          <button
            type="button"
            data-theme-toggle
            class="site-icon-button site-theme-button desktop-theme-button"
            aria-label="切换到深色模式"
          >
            <Icon name="lucide:moon" class="site-theme-icon theme-icon-light" aria-hidden="true" />
            <Icon name="lucide:sun" class="site-theme-icon theme-icon-dark" aria-hidden="true" />
          </button>

          <nav class="site-mobile-menu" aria-label="移动端导航">
            {navItems.slice(0, 2).map((item) => (
              <a href={item.href} class="site-icon-button" data-active={item.active ? 'true' : undefined} aria-label={item.label} aria-current={item.current ? 'page' : undefined}>
                <Icon name={item.icon} aria-hidden="true" />
              </a>
            ))}
            <button
              type="button"
              data-theme-toggle
              class="site-icon-button site-theme-button"
              aria-label="切换到深色模式"
            >
              <Icon name="lucide:moon" class="site-theme-icon theme-icon-light" aria-hidden="true" />
              <Icon name="lucide:sun" class="site-theme-icon theme-icon-dark" aria-hidden="true" />
            </button>
            <a href="/about" class="site-icon-button" aria-label="关于" aria-current={currentPath === '/about' ? 'page' : undefined}>
              <Icon name="lucide:info" aria-hidden="true" />
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main
      transition:name="page-content"
      transition:animate={fade({ duration: '220ms' })}
      class="flex-1 w-full max-w-4xl mx-auto px-5 sm:px-6 py-12 sm:py-16"
    >
        <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full mt-auto border-t border-[var(--line)] bg-[var(--paper-soft)] transition-colors">
        <div class="max-w-4xl mx-auto px-5 sm:px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="text-center md:text-left">
                <p class="kami-serif text-sm text-[var(--muted)] mb-2">探索、思考与记录</p>
                <p class="text-xs text-[var(--muted-light)]">&copy; {new Date().getFullYear()} FlareBlog</p>
            </div>
            <div class="flex items-center gap-4">
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-[var(--muted-light)] hover:text-[var(--ink)] transition-colors" aria-label="GitHub">
                    <Icon name="fa6-brands:github" class="text-xl" aria-hidden="true" />
                </a>
            </div>
        </div>
    </footer>

    <slot name="floating" />

    <button
      id="btn-scroll-top-global"
      class="scroll-top-global"
      type="button"
      aria-label="返回顶部"
      title="返回顶部"
    >
      <Icon name="lucide:arrow-up" class="w-5 h-5" aria-hidden="true" />
    </button>

    <style>
      .scroll-top-global {
        position: fixed;
        z-index: 45;
        left: 50%;
        bottom: calc(1.5rem + env(safe-area-inset-bottom));
        display: flex;
        width: 2.5rem;
        height: 2.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line);
        border-radius: 9999px;
        background: var(--paper-card);
        color: var(--ink);
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        cursor: pointer;
        transform: translateX(-50%) translateY(1rem);
        opacity: 0;
        pointer-events: none;
        transition: opacity 250ms ease, transform 250ms ease, border-color 200ms ease, color 200ms ease, bottom 300ms ease;
      }
      .scroll-top-global:hover {
        border-color: var(--ink);
        color: var(--ink-strong);
      }
      .scroll-top-global:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }
      .scroll-top-global:active {
        transform: translateX(-50%) translateY(0) scale(0.94) !important;
      }
      :global(body.has-scrolled:not(.is-scrolling)) .scroll-top-global {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
        pointer-events: auto;
      }
      :global(body.is-scrolling) .scroll-top-global {
        opacity: 0 !important;
        pointer-events: none !important;
        transform: translateX(-50%) translateY(1rem) !important;
      }
    </style>

    <SiteToast />

    <script>
        let navScrollController: AbortController | null = null;
        let pointerHaloController: AbortController | null = null;
        let routeProgressTimer = 0;
        let lastPointerX = -160;
        let lastPointerY = -160;
        let isPointerActive = false;

        document.addEventListener('astro:before-preparation', () => {
            if (routeProgressTimer) window.clearTimeout(routeProgressTimer);
            document.documentElement.classList.remove('route-complete');
            document.documentElement.classList.add('route-pending');
        });
        document.addEventListener('astro:after-swap', () => {
            document.documentElement.classList.add('route-pending', 'route-complete');
            document.querySelectorAll<HTMLElement>('main .page-enter').forEach((element) => {
              element.classList.add('skip-entry-animation');
            });
            routeProgressTimer = window.setTimeout(() => {
              document.documentElement.classList.remove('route-pending', 'route-complete');
              routeProgressTimer = 0;
            }, 300);
        });
        document.addEventListener('astro:page-load', () => {
            navScrollController?.abort();
            navScrollController = new AbortController();
            const navSignal = navScrollController.signal;
            const header = document.getElementById('main-header');

            // Global scroll state: has-scrolled + is-scrolling
            let scrollSettleTimer = 0;
            const handleScrollState = () => {
              if (window.scrollY > 400) {
                document.body.classList.add('has-scrolled');
              } else {
                document.body.classList.remove('has-scrolled');
              }
              document.body.classList.add('is-scrolling');
              if (scrollSettleTimer) window.clearTimeout(scrollSettleTimer);
              scrollSettleTimer = window.setTimeout(() => {
                document.body.classList.remove('is-scrolling');
              }, 450);
              if (header) header.toggleAttribute('data-scrolled', window.scrollY > 0);
            };
            window.addEventListener('scroll', handleScrollState, { passive: true, signal: navSignal });
            handleScrollState();

            // Global scroll-to-top button
            const btnScrollTopGlobal = document.getElementById('btn-scroll-top-global');
            if (btnScrollTopGlobal) {
              btnScrollTopGlobal.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }, { signal: navSignal });
            }

            pointerHaloController?.abort();
            pointerHaloController = new AbortController();
            const haloSignal = pointerHaloController.signal;
            const pointerHalo = document.querySelector<HTMLElement>('[data-pointer-halo]');
            if (!pointerHalo) return;

            // Restore state instantly without transition
            pointerHalo.style.setProperty('--pointer-x', `${lastPointerX}px`);
            pointerHalo.style.setProperty('--pointer-y', `${lastPointerY}px`);
            pointerHalo.style.transition = 'none';
            void pointerHalo.offsetWidth; // force reflow
            pointerHalo.style.transition = '';
            if (isPointerActive) {
                pointerHalo.classList.add('is-active');
            }

            const finePointer = window.matchMedia('(min-width: 768px) and (any-hover: hover) and (any-pointer: fine)');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const canActivateHalo = (): boolean => (
              finePointer.matches
              && !reducedMotion.matches
              && document.visibilityState === 'visible'
            );
            const deactivateHalo = (): void => {
                pointerHalo.classList.remove('is-active');
                isPointerActive = false;
            };
            const syncHaloAvailability = (): void => {
              if (!canActivateHalo()) deactivateHalo();
            };

            window.addEventListener('pointermove', (event) => {
              if (event.pointerType !== 'mouse' || !canActivateHalo()) {
                deactivateHalo();
                return;
              }
              lastPointerX = event.clientX;
              lastPointerY = event.clientY;
              isPointerActive = true;
              
              pointerHalo.style.setProperty('--pointer-x', `${lastPointerX}px`);
              pointerHalo.style.setProperty('--pointer-y', `${lastPointerY}px`);
              pointerHalo.classList.add('is-active');
            }, { passive: true, signal: haloSignal });
            document.documentElement.addEventListener('pointerleave', deactivateHalo, { signal: haloSignal });
            document.addEventListener('visibilitychange', syncHaloAvailability, { signal: haloSignal });
            finePointer.addEventListener('change', syncHaloAvailability, { signal: haloSignal });
            reducedMotion.addEventListener('change', syncHaloAvailability, { signal: haloSignal });
            syncHaloAvailability();

            // Scroll Reveal Logic
            if ((window as any).__scrollRevealObserver) {
                (window as any).__scrollRevealObserver.disconnect();
            }
            let visibleCount = 0;
            let resetTimer = 0;
            const scrollRevealObserver = new IntersectionObserver((entries) => {
                let hasVisible = false;
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        (entry.target as HTMLElement).style.setProperty('--reveal-idx', visibleCount.toString());
                        visibleCount++;
                        entry.target.classList.add('is-visible');
                        scrollRevealObserver.unobserve(entry.target);
                        hasVisible = true;
                    }
                });
                if (hasVisible) {
                    clearTimeout(resetTimer);
                    resetTimer = window.setTimeout(() => { visibleCount = 0; }, 100);
                }
            }, { rootMargin: '0px 0px -40px 0px' });
            
            document.querySelectorAll('.scroll-reveal').forEach(el => scrollRevealObserver.observe(el));
            (window as any).__scrollRevealObserver = scrollRevealObserver;
        });

        // 自动化添加代码块复制按钮
        function initCodeCopyButtons(root: ParentNode = document) {
            const pres = root.querySelectorAll<HTMLElement>('pre');
            pres.forEach((pre) => {
                if (pre.querySelector('.code-copy-btn')) return;
                if (window.getComputedStyle(pre).position === 'static') {
                    pre.style.position = 'relative';
                }
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'code-copy-btn';
                btn.setAttribute('aria-label', '复制代码');
                btn.title = '复制代码';
                btn.innerHTML = `
                    <svg class="copy-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                    </svg>
                    <span class="copy-text">复制</span>
                `;
                pre.appendChild(btn);
            });
        }

        if (!(window as any).__codeCopyListenerBound) {
            (window as any).__codeCopyListenerBound = true;

            // 全局 Click 事件委托，安全、防掉落
            document.addEventListener('click', (e) => {
                const target = e.target as HTMLElement | null;
                const copyBtn = target?.closest<HTMLButtonElement>('.code-copy-btn');
                if (!copyBtn) return;

                const pre = copyBtn.closest('pre');
                if (!pre) return;

                // 克隆目标代码节点并排除复制按钮本身，确保复制出的代码干净准确
                const codeEl = (pre.querySelector('code') || pre).cloneNode(true) as HTMLElement;
                codeEl.querySelectorAll('.code-copy-btn').forEach((el) => el.remove());

                const textToCopy = codeEl.textContent || '';
                if (!textToCopy.trim()) return;

                navigator.clipboard.writeText(textToCopy).then(() => {
                    copyBtn.classList.add('is-copied');
                    const textSpan = copyBtn.querySelector('.copy-text');
                    const iconSvg = copyBtn.querySelector('.copy-icon-svg');
                    const oldText = textSpan ? textSpan.textContent : '复制';

                    if (textSpan) textSpan.textContent = '已复制';
                    if (iconSvg) {
                        iconSvg.outerHTML = `
                            <svg class="copy-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        `;
                    }

                    setTimeout(() => {
                        copyBtn.classList.remove('is-copied');
                        const currentTextSpan = copyBtn.querySelector('.copy-text');
                        const currentIconSvg = copyBtn.querySelector('.copy-icon-svg');
                        if (currentTextSpan) currentTextSpan.textContent = oldText;
                        if (currentIconSvg) {
                            currentIconSvg.outerHTML = `
                                <svg class="copy-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                                </svg>
                            `;
                        }
                    }, 1800);
                }).catch((err) => {
                    console.error('复制代码失败:', err);
                });
            });

            // MutationObserver 动态监听文章页面增量出现的代码块（监听 document.documentElement 避免 Astro 视图转换替换 body 导致监听失效）
            const codeObserver = new MutationObserver(() => {
                initCodeCopyButtons(document);
            });
            codeObserver.observe(document.documentElement, { childList: true, subtree: true });
        }

        // 初始化当前页面存在的代码块
        initCodeCopyButtons(document);
        document.addEventListener('astro:page-load', () => initCodeCopyButtons(document));
        document.addEventListener('astro:after-swap', () => initCodeCopyButtons(document));
    </script>
  </body>
</html>
