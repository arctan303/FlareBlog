---
import { Icon } from 'astro-icon/components';
/**
 * 评论区组件
 * 使用客户端 JS 异步加载和提交评论
 */
export interface Props {
  articleId: number;
  initialComments?: any[];
}

import { API_BASE, TURNSTILE_SITEKEY } from '../config';

const { articleId, initialComments = [] } = Astro.props;
const apiBase = API_BASE;
const initialTotal = initialComments.length;
---

<section id="comments">
  <h3 class="kami-serif text-xl font-semibold mb-8 flex items-center gap-2 text-[var(--ink-strong)] transition-colors">
      读者来信 <span class="text-[var(--muted-light)] font-normal text-sm" id="comment-count-display">(共 {initialTotal} 条)</span>
  </h3>

  <form id="comment-form" data-article-id={articleId} data-api-base={apiBase} data-turnstile-sitekey={TURNSTILE_SITEKEY} class="mb-12 p-5 sm:p-6 border border-[var(--line)] rounded-lg bg-[var(--paper-soft)]">
      <h4 class="kami-serif text-base font-semibold text-[var(--ink-strong)] mb-4">写下回应</h4>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="comment-username" class="block mb-2 text-xs font-medium text-[var(--muted)]">昵称</label>
          <input 
              type="text" 
              id="comment-username" 
              placeholder="昵称" 
              class="w-full px-4 py-3 bg-[var(--paper-card)] border border-[var(--line)] rounded-md text-[var(--text)] placeholder:text-[var(--muted-light)] focus:outline-none focus:border-[var(--ink)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ink)_16%,transparent)] transition-[border-color,box-shadow] text-sm"
              required
          >
        </div>
        <div>
          <label for="comment-email" class="block mb-2 text-xs font-medium text-[var(--muted)]">邮箱 <span class="font-normal text-[var(--muted-light)]">（可选）</span></label>
          <input 
              type="email" 
              id="comment-email" 
              placeholder="邮箱（可选）" 
              class="w-full px-4 py-3 bg-[var(--paper-card)] border border-[var(--line)] rounded-md text-[var(--text)] placeholder:text-[var(--muted-light)] focus:outline-none focus:border-[var(--ink)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ink)_16%,transparent)] transition-[border-color,box-shadow] text-sm"
          >
        </div>
      </div>
      <label for="comment-content" class="block mb-2 text-xs font-medium text-[var(--muted)]">回应内容</label>
      <textarea 
          id="comment-content" 
          placeholder="写下你的想法..."
          class="w-full px-4 py-3 lg:py-3.5 bg-[var(--paper-card)] border border-[var(--line)] rounded-md text-[var(--text)] placeholder:text-[var(--muted-light)] focus:outline-none focus:border-[var(--ink)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ink)_16%,transparent)] transition-[border-color,box-shadow] resize-none mb-4 text-base"
          rows="4" 
          required
      ></textarea>
      <div class="flex justify-end">
          <button 
              type="submit" 
              id="comment-submit-btn"
              class="px-5 py-2.5 bg-[var(--ink)] text-[var(--paper-card)] text-sm font-medium rounded-md hover:bg-[var(--ink-strong)] transition-colors flex items-center gap-2 cursor-pointer"
          >
              <Icon name="lucide:message-circle" class="text-xs" aria-hidden="true" /> 提交回应
          </button>
      </div>
      <div id="comment-message" class="mt-4 text-sm font-medium" role="status" aria-live="polite" style="display: none;"></div>
  </form>

  <!-- 评论列表 -->
  <div id="comment-list-container">
    <div id="comments-loading" class="flex justify-center py-8" style="display: none;">
      <div class="loading-dots text-[var(--muted-light)]">
        <div></div><div></div><div></div>
      </div>
    </div>
    <div id="comment-list" class="space-y-6 lg:space-y-8">
      {initialComments.map((comment: any) => (
          <div class="group py-6 border-b border-[var(--line)] transition-colors duration-200">
              <div class="flex items-start gap-4">
                  <div class="w-9 h-9 rounded-md bg-[var(--paper-soft)] flex items-center justify-center text-sm font-semibold text-[var(--ink)] flex-shrink-0 border border-[var(--line)]">
                      {comment.username.charAt(0).toUpperCase()}
                  </div>
                  <div class="flex-grow min-w-0">
                      <div class="flex items-center justify-between mb-2">
                          <div class="flex items-center gap-2">
                              <span class="text-sm font-semibold text-[var(--ink-strong)]">{comment.username}</span>
                              <span class="text-xs text-[var(--muted-light)]">{new Date(comment.created_at * 1000).toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })}</span>
                          </div>
                      </div>
                      <p class="kami-serif text-[var(--text)] text-sm leading-[1.8] whitespace-pre-line">{comment.content}</p>
                  </div>
              </div>
          </div>
      ))}
    </div>
    <div id="comments-empty" class="text-center py-12 border-y border-dashed border-[var(--line)]" style={initialTotal > 0 ? 'display: none;' : ''}>
      <Icon name="lucide:messages-square" class="text-2xl text-[var(--line-strong)] mb-3" aria-hidden="true" />
      <p class="text-[var(--muted)]">还没有回应，欢迎写下第一封来信。</p>
    </div>
  </div>

  <!-- 评论分页 -->
  <div id="comments-pagination" class="mt-8 flex justify-center items-center gap-2" style="display: none;"></div>
</section>

<template id="comment-submit-icon-template">
  <Icon name="lucide:message-circle" class="w-3 h-3" aria-hidden="true" />
</template>
<template id="comment-loading-icon-template">
  <Icon name="lucide:loader-circle" class="w-3 h-3 animate-spin" aria-hidden="true" />
</template>

<script>
let commentPageController: AbortController | null = null;
let commentObserver: IntersectionObserver | null = null;

document.addEventListener('astro:before-swap', () => {
  commentPageController?.abort();
  commentObserver?.disconnect();
});

document.addEventListener('astro:page-load', () => {
  interface PublicComment {
    username: string;
    content: string;
    created_at: number;
  }
  interface CommentResponse {
    data?: PublicComment[];
    status?: number;
    error?: string;
    require_captcha?: boolean;
  }
  interface CommentPayload {
    username: string;
    email?: string;
    content: string;
    cf_turnstile_response?: string;
  }
  const form = document.getElementById('comment-form') as HTMLFormElement | null;
  if (!form || form.dataset.initialized) return;
  commentPageController?.abort();
  commentObserver?.disconnect();
  commentPageController = new AbortController();
  const { signal } = commentPageController;
  form.dataset.initialized = 'true';
  const articleId = form.dataset.articleId;
  const apiBase = form.dataset.apiBase;
  if (!articleId || !apiBase) return;
  let hasLoadedInitialComments = false;
  const list = document.getElementById('comment-list');
  const empty = document.getElementById('comments-empty');
  const countDisplay = document.getElementById('comment-count-display');
  const loading = document.getElementById('comments-loading');
  const submitButton = form.querySelector<HTMLButtonElement>('#comment-submit-btn');
  const message = form.querySelector<HTMLElement>('#comment-message');
  const usernameInput = form.querySelector<HTMLInputElement>('#comment-username');
  const emailInput = form.querySelector<HTMLInputElement>('#comment-email');
  const contentInput = form.querySelector<HTMLTextAreaElement>('#comment-content');
  const submitIconTemplate = document.getElementById('comment-submit-icon-template') as HTMLTemplateElement | null;
  const loadingIconTemplate = document.getElementById('comment-loading-icon-template') as HTMLTemplateElement | null;

  if (!list || !submitButton || !message || !usernameInput || !emailInput || !contentInput || !submitIconTemplate || !loadingIconTemplate) return;

  const setSubmitButtonContent = (button: HTMLButtonElement, text: string, loadingState = false): void => {
    const template = loadingState ? loadingIconTemplate : submitIconTemplate;
    button.replaceChildren(template.content.cloneNode(true), document.createTextNode(text));
  };

  // 懒加载拉取最新评论
  const escapeHtml = (unsafe: unknown): string => {
    return String(unsafe)
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
  };

  const animateStatus = (message: HTMLElement): void => {
    message.classList.remove('comment-status-enter');
    void message.offsetWidth;
    message.classList.add('comment-status-enter');
  };

  const renderComments = (comments: PublicComment[]): void => {
    if (comments.length === 0) {
      list.innerHTML = '';
      if (empty) empty.style.display = 'block';
      if (countDisplay) countDisplay.textContent = '(共 0 条)';
      return;
    }

    if (empty) empty.style.display = 'none';
    if (countDisplay) countDisplay.textContent = `(共 ${comments.length} 条)`;

    // Hybrid 模式下，直接替换静态内容为最新数据
    list.innerHTML = comments.map(comment => `
      <div class="group py-6 border-b border-[var(--line)] transition-colors duration-200">
          <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-md bg-[var(--paper-soft)] flex items-center justify-center text-sm font-semibold text-[var(--ink)] flex-shrink-0 border border-[var(--line)]">
                  ${escapeHtml(comment.username).charAt(0).toUpperCase()}
              </div>
              <div class="flex-grow min-w-0">
                  <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2">
                          <span class="text-sm font-semibold text-[var(--ink-strong)]">${escapeHtml(comment.username)}</span>
                          <span class="text-xs text-[var(--muted-light)]">${new Date(comment.created_at * 1000).toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })}</span>
                      </div>
                  </div>
                  <p class="kami-serif text-[var(--text)] text-sm leading-[1.8] whitespace-pre-line">${escapeHtml(comment.content)}</p>
              </div>
          </div>
      </div>
    `).join('');
  };

  const loadComments = async () => {
    if (hasLoadedInitialComments || signal.aborted) return;
    if (loading) loading.style.display = 'flex';
    
    try {
      const res = await fetch(`${apiBase}/api/public/articles/${articleId}/comments?page=1&limit=100`, { signal });
      if (signal.aborted) return;
      if (res.ok) {
        const json = await res.json() as CommentResponse;
        if (signal.aborted) return;
        if (Array.isArray(json.data)) {
           renderComments(json.data);
           hasLoadedInitialComments = true;
        }
      }
    } catch (e) {
      if (e instanceof DOMException && e.name === 'AbortError') return;
      console.error('Failed to load comments', e);
    } finally {
      if (loading) loading.style.display = 'none';
    }
  };

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      loadComments();
      observer.disconnect();
    }
  }, { rootMargin: '300px' });
  commentObserver = observer;
  
  const container = document.getElementById('comments');
  if (container) {
    observer.observe(container);
  }

  // 提交评论
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = submitButton;
    const msg = message;
    const username = usernameInput.value.trim();
    const email = emailInput.value.trim();
    const content = contentInput.value.trim();
    
    const turnstileSitekey = form.getAttribute('data-turnstile-sitekey') || '';

    if (!username || !content) return;

    btn.disabled = true;
    setSubmitButtonContent(btn, '提交中…', true);

    const doSubmit = async (turnstileToken: string | null): Promise<Response> => {
      const payload: CommentPayload = { username, email: email || undefined, content };
      if (turnstileToken) payload.cf_turnstile_response = turnstileToken;

      return await fetch(`${apiBase}/api/public/articles/${articleId}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal,
      });
    };

    try {
      let res = await doSubmit(null);
      let data = await res.json() as CommentResponse;

      // 需要人机验证
      if ((res.status === 403 || res.status === 429) && data.require_captcha) {
        setSubmitButtonContent(btn, '提交回应');
        btn.disabled = false;
        msg.className = 'mt-4 text-sm font-medium text-yellow-600 dark:text-yellow-400';
        msg.textContent = '请先完成人机验证：';
        msg.style.display = 'block';
        animateStatus(msg);

        // 创建 Turnstile 容器
        let tsContainer = document.getElementById('comment-turnstile');
        if (!tsContainer) {
          tsContainer = document.createElement('div');
          tsContainer.id = 'comment-turnstile';
          tsContainer.className = 'mt-3 flex justify-center';
          msg.after(tsContainer);
        }
        tsContainer.innerHTML = '';
        tsContainer.style.display = 'flex';

        await new Promise<void>((resolve, reject) => {
          const tryRender = () => {
            if (signal.aborted) {
              resolve();
              return;
            }
            const turnstile = window.turnstile;
            if (turnstile) {
              turnstile.render(tsContainer, {
                sitekey: turnstileSitekey,
                callback: async function(token) {
                  if (signal.aborted) return;
                  tsContainer.style.display = 'none';
                  msg.style.display = 'none';
                  btn.disabled = true;
                  setSubmitButtonContent(btn, '验证通过，提交中…', true);

                  try {
                    const retryRes = await doSubmit(token);
                    const retryData = await retryRes.json() as CommentResponse;
                    if (retryRes.ok) {
                      handleSuccess(retryData, msg);
                    } else {
                      throw new Error(retryData.error || '提交失败');
                    }
                    resolve();
                  } catch (e) {
                    reject(e);
                  } finally {
                    btn.disabled = false;
                    setSubmitButtonContent(btn, '提交回应');
                    turnstile.reset?.();
                  }
                }
              });
            } else if (!signal.aborted) {
              setTimeout(tryRender, 200);
            }
          };
          const loadTurnstile = window.loadTurnstileScript ? window.loadTurnstileScript() : Promise.resolve(window.turnstile);
          loadTurnstile.then(tryRender).catch(reject);
        });
        return;
      }

      if (res.ok) {
        handleSuccess(data, msg);
      } else {
        throw new Error(data.error || '提交失败');
      }
    } catch (err: unknown) {
      if (err instanceof DOMException && err.name === 'AbortError') return;
      msg.className = 'mt-4 text-sm font-medium text-red-600 dark:text-red-400';
      msg.textContent = err instanceof Error ? err.message : '评论提交失败，请稍后重试';
      msg.style.display = 'block';
      animateStatus(msg);
    } finally {
      btn.disabled = false;
      setSubmitButtonContent(btn, '提交回应');
      setTimeout(() => { msg.style.display = 'none'; }, 5000);
    }
  }, { signal });

  function handleSuccess(data: CommentResponse, msg: HTMLElement): void {
    if (data.status === 1) {
      msg.className = 'mt-4 text-sm font-medium text-green-600 dark:text-green-400';
      msg.textContent = '评论发表成功，将在下次页面构建后展示！';
      msg.style.display = 'block';
    } else if (data.status === 2) {
      msg.className = 'mt-4 text-sm font-medium text-red-600 dark:text-red-400';
      msg.textContent = '评论包含不当内容，已被系统拒绝';
      msg.style.display = 'block';
    } else {
      msg.className = 'mt-4 text-sm font-medium text-yellow-600 dark:text-yellow-400';
      msg.textContent = '评论提交成功，待人工审核后展示';
      msg.style.display = 'block';
    }
    animateStatus(msg);
    contentInput!.value = '';
  }
});
</script>
