# Worker 本地私密变量示例。复制为 worker/.dev.vars 后修改（该文件已被 .gitignore 忽略）。

# 静态构建 API 令牌（与根目录 .env.development 中的 BUILD_API_TOKEN 保持一致）
BUILD_API_TOKEN=change-me

# 管理接口密钥（/api/admin/* 使用 x-admin-api-key 头）
ADMIN_API_KEY=change-me

# 可选：Turnstile 校验密钥。未配置时评论跳过人机验证（仅保留限流）。
# 本地可使用 Cloudflare 官方测试密钥：1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
